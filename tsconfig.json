{
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"],
  "exclude": ["node_modules", "migration", "dist", ".output"],
  "compilerOptions": {
    "target": "ES2022", "jsx": "react-jsx", "module": "ESNext",
    "paths": {"@/convex/*": ["./convex/*"], "@/*": ["./src/*"]},
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["vite/client"],
    "moduleResolution": "bundler", "resolveJsonModule": true, "isolatedModules": true,
    "allowJs": true, "checkJs": false, "noEmit": true,
    "strict": false, "noImplicitAny": false, "strictFunctionTypes": true,
    "strictNullChecks": true, "skipLibCheck": true
  }
}
